{
  "name": "lsp-mcp",
  "version": "1.1.0",
  "description": "LSP 跨端扩展：一份源码，既是 pi-agent-desktop 内置能力，又能被 oh-my-pi 从 marketplace 加载；同时保留旧 MCP stdio 入口。",
  "type": "module",
  "main": "./dist/ext/index.js",
  "types": "./dist/ext/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ext/index.d.ts",
      "import": "./dist/ext/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js"
    }
  },
  "bin": {
    "lsp-mcp": "./dist/mcp-server.js"
  },
  "omp": {
    "extensions": [
      "./dist/ext/index.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/ext/index.js"
    ]
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:real": "tsc -p tsconfig.real.json",
    "test": "npm run build && node --test",
    "verify": "npm run build && node scripts/verify-lsp.mjs",
    "start": "node dist/mcp-server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "pi",
    "pi-agent-desktop",
    "oh-my-pi",
    "extension",
    "lsp",
    "mcp"
  ],
  "author": "ojbkxc",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojbkxc/lsp-mcp.git"
  },
  "homepage": "https://github.com/ojbkxc/lsp-mcp#readme",
  "bugs": {
    "url": "https://github.com/ojbkxc/lsp-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lru-cache": "^11.5.3",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-languageserver-types": "^3.18.5"
  },
  "peerDependencies": {
    "typebox": ">=1.3.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-classic": "npm:typescript@^5.7.3",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.3"
  }
}
